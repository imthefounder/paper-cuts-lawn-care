# ---- Email delivery (the live channel while no SMS sender number exists) ----
# Option A: Gmail app password. No ESP account, no domain verification, sends to
# any recipient. Enable 2-Step Verification, then create one at
# https://myaccount.google.com/apppasswords and paste the 16-character password.
GMAIL_USER=
GMAIL_APP_PASSWORD=
QUOTE_FROM_NAME=Paper Cuts Lawn Care

# Option B: Resend (https://resend.com). Free tier only delivers to the address
# that owns the account until a domain is verified.
RESEND_API_KEY=

# Where quote requests are delivered. Defaults to papercutslawn@gmail.com
QUOTE_TO_EMAIL=papercutslawn@gmail.com

# Verified sender when RESEND_API_KEY is used. onboarding@resend.dev works on
# Resend's free tier for the account owner's own address.
QUOTE_FROM_EMAIL=Paper Cuts Lawn Care <onboarding@resend.dev>

# ---- Text-message delivery (dormant until a sender number exists) ----
# Needs a Twilio number with SMS capability AND carrier registration (A2P 10DLC
# for US long codes, toll-free verification for 8xx). Until then the code stays
# inert and QUOTE_TO_SMS is unused.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Optional: send through a Messaging Service instead of a single From number.
TWILIO_MESSAGING_SERVICE_SID=

# Where the lead text lands. Defaults to the number in lib/site.ts (937) 280-5772.
QUOTE_TO_SMS=+19372805772
