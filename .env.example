# Text-message delivery (primary path). A Twilio number or Messaging Service
# texts every quote request straight to the owner's phone.
# Console: https://console.twilio.com -> Account Info (Account SID + Auth Token),
# Phone Numbers -> the number texts are sent FROM.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Optional: send through a Messaging Service instead of a single From number.
TWILIO_MESSAGING_SERVICE_SID=

# Where the lead text lands. Defaults to the number in lib/site.ts (937) 280-5772.
QUOTE_TO_SMS=+19372805772

# Optional: email delivery (keeps the yard photos attached).
# Create a free key at https://resend.com and add it in Vercel > Project > Settings > Environment Variables.
RESEND_API_KEY=

# Where quote emails are delivered. Defaults to papercutslawn@gmail.com
QUOTE_TO_EMAIL=papercutslawn@gmail.com

# Verified sender. onboarding@resend.dev works on Resend's free tier for the account owner's own address.
QUOTE_FROM_EMAIL=Paper Cuts Lawn Care <onboarding@resend.dev>
